/* 错误页面样式 */
.error-container {
  min-height: 100vh;
  background-color: #f7f7f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  box-sizing: border-box;
}

.error-mark {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx solid #ccfbf1;
  background-color: #f0fdfa;
  border-radius: 50%;
  color: #0d9488;
  font-size: 56rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1917;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.error-description {
  font-size: 26rpx;
  color: #78716c;
  text-align: center;
  line-height: 1.65;
  margin-bottom: 56rpx;
  max-width: 600rpx;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 420rpx;
  margin-bottom: 40rpx;
}

.action-btn {
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.primary-btn {
  background-color: #0d9488;
  color: #ffffff;
}

.primary-btn:active {
  background-color: #0f766e;
}

.secondary-btn {
  background-color: #ffffff;
  color: #0d9488;
  border: 2rpx solid #0d9488;
}

.secondary-btn:active {
  background-color: #f0fdfa;
}

.outline-btn {
  background-color: transparent;
  color: #57534e;
  border: 2rpx solid #e7e5e4;
}

.outline-btn:active {
  background-color: #f7f7f5;
}

/* 错误详情 */
.error-details {
  width: 100%;
  max-width: 600rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.details-header {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.details-title {
  font-size: 26rpx;
  color: #1c1917;
  font-weight: 600;
}

/* CSS 箭头，展开时翻转 */
.details-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #a8a29e;
  transition: transform 0.2s ease;
}

.details-arrow.is-open {
  transform: rotate(180deg);
}

.details-content {
  padding: 24rpx 32rpx;
  background-color: #f7f7f5;
}

.details-text {
  font-size: 24rpx;
  color: #57534e;
  line-height: 1.6;
  word-break: break-all;
}

.footer-tips {
  text-align: center;
  margin-top: 32rpx;
}

.tip-text {
  font-size: 23rpx;
  color: #a8a29e;
  display: block;
  margin-bottom: 8rpx;
}

.contact-info {
  font-size: 23rpx;
  color: #0d9488;
  display: block;
}

/* 交互反馈 */
.action-btn:active,
.details-header:active {
  opacity: 0.8;
}
