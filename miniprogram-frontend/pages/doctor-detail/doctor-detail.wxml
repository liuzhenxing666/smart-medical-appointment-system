<!-- 医生详情页面 -->
<view class="page">
  <!-- 医生基本信息 -->
  <view class="head">
    <view class="head-row">
      <image wx:if="{{doctor.avatar}}" class="avatar" src="{{doctor.avatar}}" mode="aspectFill" binderror="onImageError"></image>
      <view wx:else class="avatar avatar-ph">{{avatarText}}</view>

      <view class="head-main">
        <view class="name-line">
          <text class="name">{{doctor.name || '医生'}}</text>
          <text class="title" wx:if="{{doctor.title}}">{{doctor.title}}</text>
        </view>
        <text class="hospital" wx:if="{{doctor.hospital_name}}">{{doctor.hospital_name}}</text>
        <text class="specialty" wx:if="{{doctor.specialty}}">{{doctor.specialty}}</text>
      </view>

      <view class="score">
        <text class="score-num">{{doctor.average_rating || '—'}}</text>
        <text class="score-lab">综合评分</text>
      </view>
    </view>
  </view>

  <!-- 医生统计信息 -->
  <view class="stats">
    <view class="st">
      <text class="st-val">{{doctor.years_experience || 0}}</text>
      <text class="st-lab">从业年限</text>
    </view>
    <view class="st">
      <text class="st-val">{{doctor.patient_count || 0}}</text>
      <text class="st-lab">服务患者</text>
    </view>
    <view class="st">
      <text class="st-val">{{doctor.success_rate || 0}}%</text>
      <text class="st-lab">成功率</text>
    </view>
  </view>

  <!-- 医生介绍 -->
  <view class="section">
    <view class="sec-head">
      <text class="sec-title">医生介绍</text>
    </view>
    <text class="body">{{doctor.introduction || '暂无介绍'}}</text>
  </view>

  <!-- 擅长领域 -->
  <view class="section" wx:if="{{doctor.expertise && doctor.expertise.length > 0}}">
    <view class="sec-head">
      <text class="sec-title">擅长领域</text>
    </view>
    <view class="tags">
      <text class="tag" wx:for="{{doctor.expertise}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 排班信息 -->
  <view class="section">
    <view class="sec-head">
      <text class="sec-title">排班信息</text>
      <text class="sec-extra">未来 7 天</text>
    </view>

    <scroll-view class="tabs-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="tabs">
        <view
          class="tab {{currentDayIndex === index ? 'on' : ''}}"
          wx:for="{{scheduleDays}}"
          wx:key="index"
          data-index="{{index}}"
          bindtap="selectDay"
        >
          <text class="tab-day">{{item.day}}</text>
          <text class="tab-date">{{item.date}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="schedule" wx:if="{{currentSchedule && currentSchedule.length > 0}}">
      <view class="sch" wx:for="{{currentSchedule}}" wx:key="index">
        <view class="sch-main">
          <text class="sch-time">{{item.time_slot}}</text>
          <text class="sch-meta">{{item.type === 'morning' ? '上午' : item.type === 'afternoon' ? '下午' : '晚上'}} · ￥{{item.price}}</text>
        </view>
        <text class="sch-status {{item.available ? 'ok' : 'full'}}">{{item.available ? '可预约' : '已满'}}</text>
        <view class="btn-book {{item.available ? '' : 'off'}}" data-schedule="{{item}}" bindtap="makeAppointment">预约</view>
      </view>
    </view>

    <view class="empty" wx:else>
      <view class="empty-badge">排</view>
      <text class="empty-txt">当日暂无排班</text>
    </view>
  </view>

  <!-- 患者评价 -->
  <view class="section" wx:if="{{reviews && reviews.length > 0}}">
    <view class="sec-head">
      <text class="sec-title">患者评价</text>
      <text class="sec-extra">{{reviewStats.total}} 条</text>
    </view>

    <view class="rv-sum">
      <view class="rv-left">
        <text class="rv-score">{{doctor.average_rating || 0}}</text>
        <text class="rv-lab">综合评分</text>
      </view>
      <view class="rv-bars">
        <view class="rv-bar" wx:for="{{reviewStats.distribution}}" wx:key="index">
          <text class="rv-bar-lab">{{5 - index}}</text>
          <view class="rv-track">
            <view class="rv-fill" style="width: {{item.percentage}}%"></view>
          </view>
          <text class="rv-bar-num">{{item.count}}</text>
        </view>
      </view>
    </view>

    <view class="rv" wx:for="{{reviews}}" wx:key="id">
      <view class="rv-head">
        <image wx:if="{{item.patient_avatar}}" class="rv-avatar" src="{{item.patient_avatar}}" mode="aspectFill"></image>
        <view wx:else class="rv-avatar rv-avatar-ph">{{item.initial}}</view>
        <view class="rv-info">
          <text class="rv-name">{{item.patient_name || '匿名患者'}}</text>
          <text class="rv-time">{{item.created_at}}</text>
        </view>
        <text class="rv-mark">{{item.average_rating}} 分</text>
      </view>
      <text class="rv-content">{{item.content}}</text>
      <view class="rv-imgs" wx:if="{{item.images && item.images.length > 0}}">
        <image class="rv-img" wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill"></image>
      </view>
    </view>

    <view class="more" wx:if="{{reviewStats.total > 3}}" bindtap="viewAllReviews">查看全部评价</view>
  </view>

  <!-- 底部固定操作栏 -->
  <view class="bottom-bar">
    <view class="btn-fav {{isCollected ? 'on' : ''}}" bindtap="toggleCollect">{{isCollected ? '已收藏' : '收藏'}}</view>
    <view class="btn btn-ghost" bindtap="startConsult">在线咨询</view>
    <view class="btn btn-primary" bindtap="makeAppointmentDirect">立即预约</view>
  </view>
</view>
