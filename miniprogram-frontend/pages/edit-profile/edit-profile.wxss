/* pages/edit-profile/edit-profile.wxss */

.page {
  min-height: 100vh;
  background-color: #f7f7f5;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.section {
  margin-top: 12rpx;
  padding: 0 32rpx;
  background-color: #ffffff;
}

.section-title {
  display: block;
  padding: 30rpx 0 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
}

.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 100rpx;
}

.field + .field {
  border-top: 1rpx solid #f0efec;
}

.field-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #57534e;
}

.field-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1c1917;
}

.field-input::-webkit-input-placeholder {
  color: #a8a29e;
  font-size: 26rpx;
}

.field-picker-wrap {
  flex: 1;
  min-width: 0;
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #1c1917;
}

.picker-arrow {
  font-size: 24rpx;
  color: #a8a29e;
}

/* ---------------- 保存按钮 ---------------- */
.actions {
  padding: 40rpx 32rpx 0;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background-color: #0d9488;
  border: none;
  border-radius: 8rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background-color: #0f766e;
}

.btn-primary[disabled] {
  color: #a8a29e !important;
  background-color: #f0efec !important;
}
