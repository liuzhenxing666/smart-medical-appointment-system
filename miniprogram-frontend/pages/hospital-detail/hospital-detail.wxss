/* 医院详情页面样式 */
page {
  background-color: #f7f7f5;
}

.page {
  min-height: 100vh;
  background-color: #f7f7f5;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ---------------- 头图 ---------------- */
.hero-img {
  display: block;
  width: 100%;
  height: 380rpx;
  background-color: #f0fdfa;
}

.hero-ph {
  width: 100%;
  height: 380rpx;
  background-color: #f0fdfa;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-ph-txt {
  font-size: 72rpx;
  font-weight: 600;
  color: #0d9488;
  letter-spacing: 8rpx;
}

/* ---------------- 标题与关键信息 ---------------- */
.head {
  background-color: #ffffff;
  padding: 32rpx;
}

.head-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.h-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1c1917;
}

.h-fav {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ccfbf1;
  border-radius: 8rpx;
  background-color: #f0fdfa;
  font-size: 22rpx;
  color: #0f766e;
}

.h-fav.on {
  background-color: #0d9488;
  border-color: #0d9488;
  color: #ffffff;
}

.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.badge {
  padding: 6rpx 14rpx;
  border: 1rpx solid #ccfbf1;
  border-radius: 8rpx;
  background-color: #f0fdfa;
  font-size: 20rpx;
  color: #0f766e;
}

.badge-strong {
  background-color: #0d9488;
  border-color: #0d9488;
  color: #ffffff;
}

.badge-tcm {
  background-color: #ffffff;
  color: #78716c;
  border-color: #f0efec;
}

.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.meta-ic {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #0f766e;
}

.meta-txt {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.5;
  color: #57534e;
}

/* ---------------- 评分与规模 ---------------- */
.stats {
  display: flex;
  background-color: #ffffff;
  margin-top: 12rpx;
  padding: 30rpx 0;
}

.st {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.st + .st {
  border-left: 1rpx solid #f0efec;
}

.st-val {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1917;
}

.st-lab {
  font-size: 22rpx;
  color: #a8a29e;
}

/* ---------------- 快捷操作 ---------------- */
.quick {
  display: flex;
  background-color: #ffffff;
  margin-top: 12rpx;
  padding: 32rpx 20rpx 28rpx;
}

.qa {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.qa:active {
  opacity: 0.6;
}

.qa-ic {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f766e;
}

.qa-txt {
  font-size: 22rpx;
  color: #57534e;
}

/* 分享按钮：重置小程序 button 默认样式 */
.qa-btn {
  background-color: transparent;
  margin: 0;
  padding: 0;
  line-height: normal;
  border-radius: 8rpx;
}

.qa-btn::after {
  border: none;
}

/* ---------------- 通用区块 ---------------- */
.section {
  background-color: #ffffff;
  margin-top: 12rpx;
  padding: 32rpx;
}

.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
}

.sec-extra {
  font-size: 22rpx;
  color: #a8a29e;
}

/* 中医特色 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 18rpx;
  background-color: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #0f766e;
}

/* 科室信息 */
.dept {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0efec;
}

.dept:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dept-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-right: 20rpx;
}

.dept-name {
  font-size: 28rpx;
  color: #1c1917;
}

.dept-desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: #78716c;
}

.chev {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-top: 2rpx solid #a8a29e;
  border-right: 2rpx solid #a8a29e;
  transform: rotate(45deg);
}

/* 医院介绍 */
.intro {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #57534e;
}

/* 医院环境 */
.env-scroll {
  width: 100%;
  white-space: nowrap;
}

.env-row {
  display: inline-flex;
  gap: 16rpx;
}

.env-img {
  width: 260rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background-color: #f0fdfa;
}

/* ---------------- 底部操作栏 ---------------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #f0efec;
  z-index: 10;
}

.btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn-primary {
  flex: 1;
  background-color: #0d9488;
  color: #ffffff;
  font-weight: 600;
}

.btn-primary:active {
  background-color: #0f766e;
}

.btn-ghost {
  flex: 1;
  background-color: #ffffff;
  border: 1rpx solid #0d9488;
  color: #0d9488;
}

.btn-ghost:active {
  background-color: #f0fdfa;
}

.btn-fav {
  flex-shrink: 0;
  width: 132rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #f0efec;
  border-radius: 8rpx;
  background-color: #ffffff;
  font-size: 24rpx;
  color: #78716c;
}

.btn-fav.on {
  border-color: #ccfbf1;
  background-color: #f0fdfa;
  color: #0f766e;
}

/* ---------------- 加载 / 错误 ---------------- */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #ccfbf1;
  border-top-color: #0d9488;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.loading-txt {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #a8a29e;
}

.state-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}

.error-badge {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 16rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #0f766e;
}

.error-txt {
  margin-top: 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #78716c;
  text-align: center;
}

.btn-retry {
  margin-top: 40rpx;
  padding: 0 56rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #0d9488;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #ffffff;
}
