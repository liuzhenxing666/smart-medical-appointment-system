<!-- 登录页面 -->
<view class="page">
  <!-- 品牌标识 -->
  <view class="hero">
    <view class="brand">
      <view class="brand-mark">医</view>
      <text class="brand-name">智慧医疗</text>
    </view>
    <text class="hero-sub">预约挂号 · 在线问诊 · 健康管理</text>
  </view>

  <!-- 登录表单 -->
  <view class="form">
    <view class="field">
      <text class="field-label">手机号</text>
      <input
        class="field-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="field" wx:if="{{loginType === 'password'}}">
      <text class="field-label">密码</text>
      <input
        class="field-input"
        password="{{true}}"
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <view class="field" wx:if="{{loginType === 'code'}}">
      <text class="field-label">验证码</text>
      <input
        class="field-input"
        type="number"
        maxlength="6"
        placeholder="请输入验证码"
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <button
        class="code-btn {{countdown > 0 ? 'code-btn-disabled' : ''}}"
        bindtap="getCode"
        disabled="{{countdown > 0}}"
      >
        {{countdown > 0 ? countdown + 's后重试' : '获取验证码'}}
      </button>
    </view>
  </view>

  <view class="tip" wx:if="{{statusTip && !canSubmit}}">{{statusTip}}</view>

  <!-- 操作区 -->
  <view class="actions">
    <button
      class="btn-primary"
      bindtap="login"
      disabled="{{!canSubmit}}"
    >
      {{loginType === 'password' ? '登录' : '验证码登录'}}
    </button>

    <view class="switch">
      <text
        class="switch-item {{loginType === 'code' ? 'switch-active' : ''}}"
        bindtap="switchToCode"
      >验证码登录</text>
      <text class="switch-sep">|</text>
      <text
        class="switch-item {{loginType === 'password' ? 'switch-active' : ''}}"
        bindtap="switchToPassword"
      >密码登录</text>
    </view>

    <button class="btn-secondary" bindtap="quickLogin">快捷登录</button>
  </view>

  <!-- 协议勾选 -->
  <view class="agreement">
    <checkbox-group class="agree-group" bindchange="onAgreementChange">
      <checkbox class="agree-box" value="agree" checked="{{agreed}}" color="#0d9488" />
    </checkbox-group>
    <text class="agree-text">我已阅读并同意<text class="agree-link" bindtap="viewUserAgreement">《用户协议》</text>和<text class="agree-link" bindtap="viewPrivacyPolicy">《隐私政策》</text></text>
  </view>

  <!-- 底部入口 -->
  <view class="footer">
    <text class="footer-link" bindtap="enterAsGuest">游客模式体验</text>
    <text class="footer-sep">·</text>
    <text class="footer-link" bindtap="goToRegister">注册账号</text>
  </view>
</view>
