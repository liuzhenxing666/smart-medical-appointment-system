/* pages/login/login.wxss —— 登录：品牌顶部 + 简洁表单 */

.page {
  min-height: 100vh;
  background-color: #f7f7f5;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------------- 品牌标识 ---------------- */
.hero {
  padding: 56rpx 32rpx 72rpx;
  background-color: #0d9488;
}

.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-mark {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.16);
  border-radius: 16rpx;
}

.brand-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* ---------------- 表单 ---------------- */
.form {
  margin: 24rpx 32rpx 0;
  padding: 0 28rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
}

.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 100rpx;
}

.field + .field {
  border-top: 1rpx solid #f0efec;
}

.field-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #57534e;
}

.field-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1c1917;
}

.field-input::-webkit-input-placeholder {
  color: #a8a29e;
  font-size: 26rpx;
}

.code-btn {
  flex-shrink: 0;
  width: 168rpx;
  height: 56rpx;
  line-height: 54rpx;
  padding: 0;
  margin: 0;
  font-size: 22rpx;
  color: #0d9488;
  background-color: #ffffff;
  border: 1rpx solid #0d9488;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.code-btn::after {
  border: none;
}

.code-btn-disabled,
.code-btn[disabled] {
  color: #a8a29e !important;
  border-color: #f0efec !important;
  background-color: #ffffff !important;
}

.tip {
  margin: 16rpx 32rpx 0;
  font-size: 22rpx;
  color: #78716c;
}

/* ---------------- 操作区 ---------------- */
.actions {
  padding: 24rpx 32rpx 0;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background-color: #0d9488;
  border: none;
  border-radius: 8rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background-color: #0f766e;
}

.btn-primary[disabled] {
  color: #a8a29e !important;
  background-color: #f0efec !important;
}

.switch {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx 0;
}

.switch-item {
  font-size: 24rpx;
  color: #a8a29e;
}

.switch-active {
  color: #0d9488;
  font-weight: 600;
}

.switch-sep {
  font-size: 22rpx;
  color: #f0efec;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 86rpx;
  padding: 0;
  font-size: 26rpx;
  color: #0d9488;
  background-color: #ffffff;
  border: 1rpx solid #0d9488;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background-color: #f0fdfa;
}

/* ---------------- 协议勾选 ---------------- */
.agreement {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 32rpx 32rpx 0;
}

.agree-group {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.agree-box {
  transform: scale(0.7);
  transform-origin: center;
}

.agree-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 36rpx;
  color: #78716c;
}

.agree-link {
  color: #0d9488;
}

/* ---------------- 底部入口 ---------------- */
.footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 32rpx 0;
}

.footer-link {
  font-size: 24rpx;
  color: #57534e;
}

.footer-sep {
  font-size: 22rpx;
  color: #a8a29e;
}
