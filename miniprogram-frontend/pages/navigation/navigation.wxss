/* pages/navigation/navigation.wxss —— 医院导航：搜索 + 地图 + 列表 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f7f7f5;
  box-sizing: border-box;
}

/* ---------------- 搜索 ---------------- */
.search-bar {
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0efec;
  flex-shrink: 0;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 20rpx;
  background-color: #f7f7f5;
  border-radius: 8rpx;
}

.search-ico {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.search-ico-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #78716c;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-ico-line {
  position: absolute;
  right: 0;
  bottom: 5rpx;
  width: 10rpx;
  height: 2rpx;
  background-color: #78716c;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  color: #1c1917;
}

.search-input::-webkit-input-placeholder {
  color: #a8a29e;
  font-size: 26rpx;
}

.search-clear {
  padding: 0 8rpx;
  font-size: 32rpx;
  line-height: 1;
  color: #a8a29e;
}

/* ---------------- 地图 ---------------- */
.map-section {
  position: relative;
  height: 420rpx;
  flex-shrink: 0;
  background-color: #e7e5e4;
}

.hospital-map {
  width: 100%;
  height: 100%;
}

.map-controls {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.map-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border: 1rpx solid #f0efec;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.map-btn:active {
  background-color: #f0fdfa;
}

/* 定位图标：旋转方形 + 中心点，纯 CSS 绘制 */
.ico-locate {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #0f766e;
  border-radius: 8rpx;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.ico-locate-dot {
  width: 8rpx;
  height: 8rpx;
  margin: 5rpx auto 0;
  background-color: #0d9488;
  border-radius: 8rpx;
}

.map-btn-txt {
  font-size: 32rpx;
  line-height: 1;
  color: #0f766e;
}

/* ---------------- 医院列表 ---------------- */
.list-section {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
  background-color: #ffffff;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0efec;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
}

.list-count {
  font-size: 22rpx;
  color: #a8a29e;
}

.hospital-list {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.hospital-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0efec;
}

.hospital-item:last-child {
  border-bottom: none;
}

.hospital-item:active {
  opacity: 0.6;
}

.hospital-thumb {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  background-color: #e7e5e4;
  border-radius: 8rpx;
}

.hospital-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hospital-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1917;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hospital-address {
  font-size: 22rpx;
  color: #78716c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hospital-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hospital-distance {
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #0d9488;
  background-color: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 8rpx;
}

.hospital-rating {
  font-size: 20rpx;
  color: #a8a29e;
}

.hospital-arrow {
  font-size: 24rpx;
  color: #a8a29e;
}

/* ---------------- 空状态 ---------------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 0;
}

.empty-badge {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f766e;
  background-color: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  border-radius: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #78716c;
}

.btn-ghost {
  width: 200rpx;
  height: 64rpx;
  line-height: 62rpx;
  padding: 0;
  margin: 8rpx 0 0;
  font-size: 24rpx;
  color: #0d9488;
  background-color: #ffffff;
  border: 1rpx solid #0d9488;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.btn-ghost::after {
  border: none;
}

.btn-ghost:active {
  background-color: #f0fdfa;
}

/* ---------------- 路线规划面板 ---------------- */
.route-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background-color: #ffffff;
  border-top: 1rpx solid #f0efec;
  border-radius: 16rpx 16rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0efec;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
}

.panel-close {
  padding: 0 8rpx;
  font-size: 32rpx;
  line-height: 1;
  color: #a8a29e;
}

.route-info {
  padding: 12rpx 32rpx;
}

.route-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.route-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #78716c;
}

.route-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #1c1917;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-actions {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 32rpx 32rpx;
}

.route-btn {
  flex: 1;
  height: 80rpx;
  line-height: 78rpx;
  padding: 0;
  font-size: 26rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.route-btn::after {
  border: none;
}

.route-primary {
  color: #ffffff;
  background-color: #0d9488;
  border: none;
}

.route-primary:active {
  background-color: #0f766e;
}

.route-ghost {
  color: #0d9488;
  background-color: #ffffff;
  border: 1rpx solid #0d9488;
}

.route-ghost:active {
  background-color: #f0fdfa;
}

/* ---------------- 遮罩状态 ---------------- */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.35);
}

.overlay-card {
  min-width: 360rpx;
  padding: 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.overlay-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
}

.overlay-text {
  font-size: 26rpx;
  color: #78716c;
  text-align: center;
}
