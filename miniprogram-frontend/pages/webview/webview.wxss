/* WebView页面样式 */
.webview-container {
  height: 100vh;
  background-color: #f7f7f5;
}

.webview-content {
  width: 100%;
  height: 100%;
}

web-view {
  width: 100%;
  height: 100%;
}

/* 加载失败状态 */
.state {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  box-sizing: border-box;
}

.state-mark {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx solid #ccfbf1;
  background-color: #f0fdfa;
  border-radius: 50%;
  color: #0d9488;
  font-size: 56rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1917;
  margin-bottom: 16rpx;
}

.state-desc {
  font-size: 26rpx;
  color: #78716c;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 48rpx;
}

.state-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 64rpx;
  background-color: #0d9488;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 8rpx;
}

.state-btn:active {
  background-color: #0f766e;
}
