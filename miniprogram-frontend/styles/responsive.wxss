/* 响应式设计变量 */
:root {
  --screen-xs: 480rpx;
  --screen-sm: 768rpx;
  --screen-md: 992rpx;
  --screen-lg: 1200rpx;
  --screen-xl: 1600rpx;
}

/* 基础容器 */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* 响应式布局 */
.container {
  width: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
}

@media (min-width: 768rpx) {
  .container {
    max-width: 750rpx;
    margin: 0 auto;
  }
}

@media (min-width: 1200rpx) {
  .container {
    max-width: 1200rpx;
    margin: 0 auto;
  }
}

/* 响应式网格系统 */
.row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -15rpx;
}

.col {
  padding: 0 15rpx;
  box-sizing: border-box;
}

.col-xs-1 { flex: 0 0 8.333333%; max-width: 8.333333%; }
.col-xs-2 { flex: 0 0 16.666667%; max-width: 16.666667%; }
.col-xs-3 { flex: 0 0 25%; max-width: 25%; }
.col-xs-4 { flex: 0 0 33.333333%; max-width: 33.333333%; }
.col-xs-5 { flex: 0 0 41.666667%; max-width: 41.666667%; }
.col-xs-6 { flex: 0 0 50%; max-width: 50%; }
.col-xs-7 { flex: 0 0 58.333333%; max-width: 58.333333%; }
.col-xs-8 { flex: 0 0 66.666667%; max-width: 66.666667%; }
.col-xs-9 { flex: 0 0 75%; max-width: 75%; }
.col-xs-10 { flex: 0 0 83.333333%; max-width: 83.333333%; }
.col-xs-11 { flex: 0 0 91.666667%; max-width: 91.666667%; }
.col-xs-12 { flex: 0 0 100%; max-width: 100%; }

@media (min-width: 768rpx) {
  .col-sm-1 { flex: 0 0 8.333333%; max-width: 8.333333%; }
  .col-sm-2 { flex: 0 0 16.666667%; max-width: 16.666667%; }
  .col-sm-3 { flex: 0 0 25%; max-width: 25%; }
  .col-sm-4 { flex: 0 0 33.333333%; max-width: 33.333333%; }
  .col-sm-5 { flex: 0 0 41.666667%; max-width: 41.666667%; }
  .col-sm-6 { flex: 0 0 50%; max-width: 50%; }
  .col-sm-7 { flex: 0 0 58.333333%; max-width: 58.333333%; }
  .col-sm-8 { flex: 0 0 66.666667%; max-width: 66.666667%; }
  .col-sm-9 { flex: 0 0 75%; max-width: 75%; }
  .col-sm-10 { flex: 0 0 83.333333%; max-width: 83.333333%; }
  .col-sm-11 { flex: 0 0 91.666667%; max-width: 91.666667%; }
  .col-sm-12 { flex: 0 0 100%; max-width: 100%; }
}

@media (min-width: 1200rpx) {
  .col-lg-1 { flex: 0 0 8.333333%; max-width: 8.333333%; }
  .col-lg-2 { flex: 0 0 16.666667%; max-width: 16.666667%; }
  .col-lg-3 { flex: 0 0 25%; max-width: 25%; }
  .col-lg-4 { flex: 0 0 33.333333%; max-width: 33.333333%; }
  .col-lg-5 { flex: 0 0 41.666667%; max-width: 41.666667%; }
  .col-lg-6 { flex: 0 0 50%; max-width: 50%; }
  .col-lg-7 { flex: 0 0 58.333333%; max-width: 58.333333%; }
  .col-lg-8 { flex: 0 0 66.666667%; max-width: 66.666667%; }
  .col-lg-9 { flex: 0 0 75%; max-width: 75%; }
  .col-lg-10 { flex: 0 0 83.333333%; max-width: 83.333333%; }
  .col-lg-11 { flex: 0 0 91.666667%; max-width: 91.666667%; }
  .col-lg-12 { flex: 0 0 100%; max-width: 100%; }
}

/* 响应式文字大小 */
.text-xs { font-size: 24rpx; }
.text-sm { font-size: 28rpx; }
.text-base { font-size: 32rpx; }
.text-lg { font-size: 36rpx; }
.text-xl { font-size: 40rpx; }
.text-2xl { font-size: 48rpx; }
.text-3xl { font-size: 60rpx; }

@media (min-width: 768rpx) {
  .text-sm { font-size: 26rpx; }
  .text-base { font-size: 30rpx; }
  .text-lg { font-size: 34rpx; }
  .text-xl { font-size: 38rpx; }
  .text-2xl { font-size: 44rpx; }
  .text-3xl { font-size: 54rpx; }
}

@media (min-width: 1200rpx) {
  .text-base { font-size: 28rpx; }
  .text-lg { font-size: 32rpx; }
  .text-xl { font-size: 36rpx; }
  .text-2xl { font-size: 40rpx; }
  .text-3xl { font-size: 48rpx; }
}

/* 响应式间距 */
.m-0 { margin: 0; }
.m-1 { margin: 8rpx; }
.m-2 { margin: 16rpx; }
.m-3 { margin: 24rpx; }
.m-4 { margin: 32rpx; }
.m-5 { margin: 40rpx; }

.p-0 { padding: 0; }
.p-1 { padding: 8rpx; }
.p-2 { padding: 16rpx; }
.p-3 { padding: 24rpx; }
.p-4 { padding: 32rpx; }
.p-5 { padding: 40rpx; }

/* 响应式显示隐藏 */
.d-none { display: none; }
.d-block { display: block; }
.d-flex { display: flex; }
.d-inline { display: inline; }
.d-inline-block { display: inline-block; }

@media (max-width: 767rpx) {
  .d-sm-none { display: none; }
  .d-sm-block { display: block; }
  .d-sm-flex { display: flex; }
  .d-sm-inline { display: inline; }
  .d-sm-inline-block { display: inline-block; }
}

@media (min-width: 768rpx) and (max-width: 1199rpx) {
  .d-md-none { display: none; }
  .d-md-block { display: block; }
  .d-md-flex { display: flex; }
  .d-md-inline { display: inline; }
  .d-md-inline-block { display: inline-block; }
}

@media (min-width: 1200rpx) {
  .d-lg-none { display: none; }
  .d-lg-block { display: block; }
  .d-lg-flex { display: flex; }
  .d-lg-inline { display: inline; }
  .d-lg-inline-block { display: inline-block; }
}

/* 响应式卡片布局 */
.card-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
}

@media (min-width: 768rpx) {
  .card-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1200rpx) {
  .card-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* 响应式列表项 */
.list-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

@media (min-width: 768rpx) {
  .list-item {
    padding: 30rpx;
    margin-bottom: 20rpx;
  }
}

@media (min-width: 1200rpx) {
  .list-item {
    padding: 36rpx;
    margin-bottom: 24rpx;
  }
}

/* 响应式按钮 */
.btn {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  text-align: center;
}

@media (min-width: 768rpx) {
  .btn {
    padding: 18rpx 36rpx;
    font-size: 26rpx;
  }
}

@media (min-width: 1200rpx) {
  .btn {
    padding: 16rpx 40rpx;
    font-size: 24rpx;
  }
}

/* 响应式表单 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.form-control {
  width: 100%;
  padding: 20rpx;
  font-size: 28rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

@media (min-width: 768rpx) {
  .form-group {
    margin-bottom: 36rpx;
  }
  
  .form-label {
    font-size: 26rpx;
  }
  
  .form-control {
    padding: 18rpx;
    font-size: 26rpx;
  }
}

@media (min-width: 1200rpx) {
  .form-group {
    margin-bottom: 40rpx;
  }
  
  .form-label {
    font-size: 24rpx;
  }
  
  .form-control {
    padding: 16rpx;
    font-size: 24rpx;
  }
}