{
  "pages": [
    "pages/index/index",
    "pages/hospitals/hospitals",
    "pages/hospital-detail/hospital-detail",
    "pages/doctors/doctors",
    "pages/doctor-detail/doctor-detail",
    "pages/appointment-create/appointment-create",
    "pages/my-appointments/my-appointments",
    "pages/profile/profile",
    "pages/edit-profile/edit-profile",
    "pages/login/login",
    "pages/webview/webview",
    "pages/error/error",
    "pages/agreement/agreement",
    "pages/privacy/privacy",
    "pages/navigation/navigation"
  ],
  "entryPagePath": "pages/index/index",
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#0d9488",
    "navigationBarTitleText": "智慧医疗预约平台",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#f7f7f5",
    "enablePullDownRefresh": true,
    "onReachBottomDistance": 50
  },
  "tabBar": {
    "color": "#78716c",
    "selectedColor": "#0d9488",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "assets/icons/home-outline.png",
        "selectedIconPath": "assets/icons/home-filled.png"
      },
      {
        "pagePath": "pages/hospitals/hospitals",
        "text": "医院",
        "iconPath": "assets/icons/hospital-outline.png",
        "selectedIconPath": "assets/icons/hospital-filled.png"
      },
      {
        "pagePath": "pages/doctors/doctors",
        "text": "医生",
        "iconPath": "assets/icons/doctor-outline.png",
        "selectedIconPath": "assets/icons/doctor-filled.png"
      },
      {
        "pagePath": "pages/my-appointments/my-appointments",
        "text": "预约",
        "iconPath": "assets/icons/calendar-outline.png",
        "selectedIconPath": "assets/icons/calendar-filled.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "assets/icons/profile-outline.png",
        "selectedIconPath": "assets/icons/profile-filled.png"
      }
    ]
  },
  "networkTimeout": {
    "request": 15000,
    "downloadFile": 15000,
    "uploadFile": 15000
  },
  "permission": {
    "scope.userLocation": {
      "desc": "你的位置信息将用于小程序定位服务"
    }
  },
  "requiredPrivateInfos": ["getLocation"],
  "requiredBackgroundModes": ["location"],
  "plugins": {},
  "subPackages": [],

  "usingComponents": {
    "search-bar": "components/search-bar/search-bar",
    "list-item": "components/list-item/list-item",
    "empty-state": "components/empty-state/empty-state"
  },
  "lazyCodeLoading": "requiredComponents",
  "debug": false,
  "functionalPages": {
    "independent": true
  },
  "resizable": false,
  "style": "v2",
  "sitemapLocation": "sitemap.json"
}