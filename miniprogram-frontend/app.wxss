/* 布局样式 */
.flex { display: flex; }
.inline-flex { display: inline-flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }
.flex-nowrap { flex-wrap: nowrap; }

.items-start { align-items: flex-start; }
.items-center { align-items: center; }
.items-end { align-items: flex-end; }
.items-stretch { align-items: stretch; }
.items-baseline { align-items: baseline; }

.justify-start { justify-content: flex-start; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }
.justify-evenly { justify-content: space-evenly; }

.flex-1 { flex: 1; }
.flex-auto { flex: auto; }
.flex-none { flex: none; }
.flex-grow { flex-grow: 1; }
.flex-shrink { flex-shrink: 1; }

.self-auto { align-self: auto; }
.self-start { align-self: flex-start; }
.self-center { align-self: center; }
.self-end { align-self: flex-end; }
.self-stretch { align-self: stretch; }

/* 网格布局（flex 版本，页面统一使用 .grid-item 宽度类） */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 calc(-1 * var(--spacing-sm) / 2);
}
.gap-xs { gap: var(--spacing-xs); }
.gap-sm { gap: var(--spacing-sm); }
.gap-md { gap: var(--spacing-md); }
.gap-base { gap: var(--spacing-base); }
.gap-lg { gap: var(--spacing-lg); }
.gap-xl { gap: var(--spacing-xl); }
.gap-2xl { gap: var(--spacing-2xl); }

/* 定位样式 */
.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }
.sticky { position: sticky; }

.top-0 { top: 0; }
.right-0 { right: 0; }
.bottom-0 { bottom: 0; }
.left-0 { left: 0; }

.inset-0 {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

/* 尺寸样式 */
.w-full { width: 100%; }
.h-full { height: 100%; }
.w-screen { width: 100vw; }
.h-screen { height: 100vh; }

/* 显示样式 */
.block { display: block; }
.inline-block { display: inline-block; }
.inline { display: inline; }
.hidden { display: none; }

/* 溢出处理 */
.overflow-hidden { overflow: hidden; }
.overflow-visible { overflow: visible; }
.overflow-scroll { overflow: scroll; }
.overflow-auto { overflow: auto; }

.overflow-x-hidden { overflow-x: hidden; }
.overflow-y-hidden { overflow-y: hidden; }
.overflow-x-scroll { overflow-x: scroll; }
.overflow-y-scroll { overflow-y: scroll; }
.overflow-x-auto { overflow-x: auto; }
.overflow-y-auto { overflow-y: auto; }

/* 边框样式 */
.border { border: 1rpx solid var(--border-color); }
.border-t { border-top: 1rpx solid var(--border-color); }
.border-r { border-right: 1rpx solid var(--border-color); }
.border-b { border-bottom: 1rpx solid var(--border-color); }
.border-l { border-left: 1rpx solid var(--border-color); }

.border-0 { border-width: 0; }
.border-2 { border-width: 2rpx; }
.border-4 { border-width: 4rpx; }

.border-primary { border-color: var(--primary-color); }
.border-secondary { border-color: var(--gray-300); }
.border-success { border-color: var(--success-color); }
.border-warning { border-color: var(--warning-color); }
.border-error { border-color: var(--error-color); }

/* 圆角样式 */
.rounded-none { border-radius: 0; }
.rounded-sm { border-radius: var(--border-radius-sm); }
.rounded { border-radius: var(--border-radius); }
.rounded-md { border-radius: var(--border-radius-md); }
.rounded-lg { border-radius: var(--border-radius-lg); }
.rounded-xl { border-radius: var(--border-radius-xl); }
.rounded-full { border-radius: var(--border-radius-full); }

.rounded-t-none { border-top-left-radius: 0; border-top-right-radius: 0; }
.rounded-b-none { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.rounded-l-none { border-top-left-radius: 0; border-bottom-left-radius: 0; }
.rounded-r-none { border-top-right-radius: 0; border-bottom-right-radius: 0; }

/* 阴影样式 */
.shadow-none { box-shadow: none; }
.shadow-xs { box-shadow: var(--shadow-xs); }
.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow { box-shadow: var(--shadow); }
.shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); }
.shadow-xl { box-shadow: var(--shadow-xl); }

/* 背景色样式 */
.bg-transparent { background-color: transparent; }
.bg-primary { background-color: var(--bg-primary); }
.bg-secondary { background-color: var(--bg-secondary); }
.bg-tertiary { background-color: var(--bg-tertiary); }
.bg-muted { background-color: var(--bg-muted); }

.bg-primary-50 { background-color: var(--primary-50); }
.bg-primary-100 { background-color: var(--primary-100); }
.bg-primary-500 { background-color: var(--primary-500); }
.bg-primary-600 { background-color: var(--primary-600); }
.bg-primary-700 { background-color: var(--primary-700); }

.bg-success { background-color: var(--success-color); }
.bg-success-light { background-color: var(--success-light); }
.bg-warning { background-color: var(--warning-color); }
.bg-warning-light { background-color: var(--warning-light); }
.bg-error { background-color: var(--error-color); }
.bg-error-light { background-color: var(--error-light); }
.bg-info { background-color: var(--info-color); }
.bg-info-light { background-color: var(--info-light); }

.bg-gray-50 { background-color: var(--gray-50); }
.bg-gray-100 { background-color: var(--gray-100); }
.bg-gray-200 { background-color: var(--gray-200); }
.bg-gray-300 { background-color: var(--gray-300); }
.bg-gray-400 { background-color: var(--gray-400); }
.bg-gray-500 { background-color: var(--gray-500); }
.bg-gray-600 { background-color: var(--gray-600); }
.bg-gray-700 { background-color: var(--gray-700); }
.bg-gray-800 { background-color: var(--gray-800); }
.bg-gray-900 { background-color: var(--gray-900); }

/* 卡片样式 */
.card {
  background: var(--bg-primary);
  border-radius: var(--border-radius-lg);
  box-shadow: var(--shadow);
  padding: var(--spacing-base);
  margin-bottom: var(--spacing-base);
}

.card-header {
  border-bottom: 1rpx solid var(--border-color);
  padding-bottom: var(--spacing-sm);
  margin-bottom: var(--spacing-base);
}

.card-footer {
  border-top: 1rpx solid var(--border-color);
  padding-top: var(--spacing-sm);
  margin-top: var(--spacing-base);
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  border-radius: var(--border-radius);
  font-size: var(--font-size-base);
  font-weight: 500;
  text-align: center;
  border: none;
  outline: none;
  transition: all 0.2s ease;
  min-height: 80rpx;
  box-sizing: border-box;
}

.btn:active {
  transform: translateY(1rpx);
}

.btn-primary {
  background: var(--primary-color);
  color: white;
}

.btn-primary:active {
  background: var(--primary-dark);
}

.btn-secondary {
  background: var(--bg-muted);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-color);
}

.btn-secondary:active {
  background: var(--border-color);
}

.btn-success {
  background: var(--success-color);
  color: white;
}

.btn-warning {
  background: var(--warning-color);
  color: white;
}

.btn-error {
  background: var(--error-color);
  color: white;
}

.btn-outline {
  background: transparent;
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
}

.btn-outline:active {
  background: var(--primary-color);
  color: white;
}

.btn-sm {
  padding: 16rpx 24rpx;
  font-size: var(--font-size-sm);
  min-height: 64rpx;
}

.btn-lg {
  padding: 24rpx 40rpx;
  font-size: var(--font-size-lg);
  min-height: 96rpx;
}

.btn-block {
  width: 100%;
}

.btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* 表单样式 */
.form-group {
  margin-bottom: var(--spacing-base);
}

.form-label {
  display: block;
  margin-bottom: var(--spacing-xs);
  font-weight: 500;
  color: var(--text-primary);
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--border-radius);
  font-size: var(--font-size-base);
  background: var(--bg-primary);
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--primary-color);
  outline: none;
}

.form-input-error {
  border-color: var(--error-color);
}

.form-textarea {
  min-height: 200rpx;
  resize: vertical;
}

.form-select {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--border-radius);
  font-size: var(--font-size-base);
  background: var(--bg-primary);
  box-sizing: border-box;
}

/* 列表样式 */
.list {
  background: var(--bg-primary);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
}

.list-item {
  padding: var(--spacing-base);
  border-bottom: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background: var(--bg-muted);
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: var(--border-radius);
  font-size: var(--font-size-sm);
  font-weight: 500;
}

.tag-primary {
  background: var(--primary-light);
  color: white;
}

.tag-success {
  background: var(--success-color);
  color: white;
}

.tag-warning {
  background: var(--warning-color);
  color: white;
}

.tag-error {
  background: var(--error-color);
  color: white;
}

.tag-outline {
  background: transparent;
  color: var(--text-secondary);
  border: 1rpx solid var(--border-color);
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid var(--border-color);
  border-top: 3rpx solid var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: var(--spacing-2xl);
  color: var(--text-muted);
}

.empty-state-icon {
  font-size: 120rpx;
  margin-bottom: var(--spacing-base);
  opacity: 0.5;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .container {
    padding: var(--spacing-sm);
  }
  
  .card {
    padding: var(--spacing-sm);
  }
  
  .btn {
    padding: 16rpx 24rpx;
    min-height: 72rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  page {
    --text-primary: #e2e8f0;
    --text-secondary: #a0aec0;
    --text-muted: #718096;
    
    --bg-primary: #2d3748;
    --bg-secondary: #1a202c;
    --bg-muted: #4a5568;
    
    --border-color: #4a5568;
  }
}

/* 现代化组件样式 */

/* 徽章组件 */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.badge-primary {
  background-color: var(--primary-color);
  color: white;
}

.badge-secondary {
  background-color: var(--gray-500);
  color: white;
}

.badge-success {
  background-color: var(--success-color);
  color: white;
}

.badge-warning {
  background-color: var(--warning-color);
  color: white;
}

.badge-error {
  background-color: var(--error-color);
  color: white;
}

/* 头像组件 */
.avatar {
  position: relative;
  display: inline-block;
  overflow: hidden;
  background-color: var(--gray-200);
  border-radius: 50%;
}

.avatar-xs {
  width: 48rpx;
  height: 48rpx;
}

.avatar-sm {
  width: 64rpx;
  height: 64rpx;
}

.avatar-md {
  width: 80rpx;
  height: 80rpx;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
}

.avatar-xl {
  width: 160rpx;
  height: 160rpx;
}

.avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 28rpx;
  color: var(--text-muted);
  background-color: var(--gray-100);
}

/* 评分组件 */
.rating {
  display: flex;
  align-items: center;
}

.rating-star {
  color: var(--warning-color);
  font-size: 24rpx;
  margin-right: 4rpx;
}

.rating-star-empty {
  color: var(--gray-300);
}

.rating-text {
  margin-left: var(--spacing-xs);
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: var(--border-color);
  margin: var(--spacing-base) 0;
}

.divider-dashed {
  border-top: 1rpx dashed var(--border-color);
  background: transparent;
}

.divider-vertical {
  width: 1rpx;
  height: 100%;
  background-color: var(--border-color);
  margin: 0 var(--spacing-sm);
}

/* 步骤条 */
.steps {
  display: flex;
  padding: var(--spacing-lg) 0;
}

.steps-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.steps-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 30rpx;
  left: 50%;
  width: 100%;
  height: 2rpx;
  background-color: var(--gray-300);
  z-index: 1;
}

.steps-item.active:not(:last-child)::after {
  background-color: var(--primary-color);
}

.steps-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto var(--spacing-sm);
  border-radius: 50%;
  background-color: var(--gray-300);
  color: white;
  font-weight: 600;
  position: relative;
  z-index: 2;
}

.steps-item.active .steps-icon {
  background-color: var(--primary-color);
}

.steps-item.completed .steps-icon {
  background-color: var(--success-color);
}

.steps-title {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.steps-item.active .steps-title {
  color: var(--primary-color);
  font-weight: 500;
}

/* 折叠面板 */
.collapse {
  background: var(--bg-primary);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.collapse-item {
  border-bottom: 1rpx solid var(--border-color);
}

.collapse-item:last-child {
  border-bottom: none;
}

.collapse-header {
  padding: var(--spacing-base);
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}

.collapse-title {
  font-weight: 500;
  color: var(--text-primary);
}

.collapse-arrow {
  color: var(--text-muted);
  transition: transform 0.2s;
}

.collapse-item.active .collapse-arrow {
  transform: rotate(180deg);
}

.collapse-content {
  padding: 0 var(--spacing-base) var(--spacing-base);
  color: var(--text-secondary);
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.collapse-item.active .collapse-content {
  max-height: 2000rpx;
}

/* 搜索框 */
.search-box {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
  border-radius: var(--border-radius-lg);
  padding: 0 var(--spacing-base);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: var(--font-size-base);
  color: var(--text-primary);
  background: transparent;
  border: none;
  outline: none;
}

.search-icon {
  color: var(--text-muted);
  margin-right: var(--spacing-sm);
}

.search-clear {
  color: var(--text-muted);
  margin-left: var(--spacing-sm);
}

/* 通知提示 */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: var(--spacing-base) var(--spacing-lg);
  border-radius: var(--border-radius);
  background-color: rgba(0, 0, 0, 0.8);
  color: white;
  font-size: var(--font-size-base);
  z-index: var(--z-index-toast);
  max-width: 80%;
  text-align: center;
}

.toast-success {
  background-color: var(--success-color);
}

.toast-error {
  background-color: var(--error-color);
}

.toast-warning {
  background-color: var(--warning-color);
}

/* 浮动操作按钮 */
.fab {
  position: fixed;
  bottom: var(--spacing-xl);
  right: var(--spacing-lg);
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: var(--z-index-fab);
  font-size: 48rpx;
}

.fab:active {
  transform: scale(0.95);
}

.fab-sm {
  width: 96rpx;
  height: 96rpx;
  font-size: 40rpx;
}

.fab-lg {
  width: 128rpx;
  height: 128rpx;
  font-size: 56rpx;
}

/* 标签页 */
.tabs {
  display: flex;
  background: var(--bg-primary);
  border-bottom: 1rpx solid var(--border-color);
}

.tabs-item {
  flex: 1;
  text-align: center;
  padding: var(--spacing-base) 0;
  font-size: var(--font-size-base);
  color: var(--text-secondary);
  position: relative;
}

.tabs-item.active {
  color: var(--primary-color);
  font-weight: 500;
}

.tabs-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 4rpx 4rpx 0 0;
}

/* 时间线 */
.timeline {
  padding: var(--spacing-base) 0;
}

.timeline-item {
  position: relative;
  padding-left: var(--spacing-2xl);
  padding-bottom: var(--spacing-xl);
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 30rpx;
  height: calc(100% - var(--spacing-xl));
  width: 2rpx;
  background-color: var(--border-color);
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background-color: var(--gray-300);
  border: 4rpx solid var(--bg-primary);
}

.timeline-item.active .timeline-dot {
  background-color: var(--primary-color);
}

.timeline-item.completed .timeline-dot {
  background-color: var(--success-color);
}

.timeline-content {
  background: var(--bg-primary);
  padding: var(--spacing-base);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
}

.timeline-title {
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.timeline-desc {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.grid-item {
  padding: calc(var(--spacing-sm) / 2);
  box-sizing: border-box;
}

.grid-1 { width: 100%; }
.grid-2 { width: 50%; }
.grid-3 { width: 33.333%; }
.grid-4 { width: 25%; }
.grid-5 { width: 20%; }

/* 响应式网格 */
@media (max-width: 750rpx) {
  .grid-2, .grid-3, .grid-4, .grid-5 {
    width: 50%;
  }
}

@media (max-width: 500rpx) {
  .grid-2, .grid-3, .grid-4, .grid-5 {
    width: 100%;
  }
}

/* 动画效果 */
.fade-in {
  animation: fadeIn 0.3s ease-in-out;
}

.fade-out {
  animation: fadeOut 0.3s ease-in-out;
}

.slide-up {
  animation: slideUp 0.3s ease-in-out;
}

.slide-down {
  animation: slideDown 0.3s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes slideDown {
  from { transform: translateY(-100%); }
  to { transform: translateY(0); }
}